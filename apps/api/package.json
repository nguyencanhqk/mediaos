{
  "name": "@mediaos/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build && node ../../scripts/stamp-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run src/workflow --coverage --coverage.include=src/workflow/**",
    "test:cov:sensitive": "vitest run src/auth src/permission src/employees test/integration/auth.int-spec.ts test/integration/auth-me-bootstrap.int-spec.ts test/integration/two-factor-login.int-spec.ts test/integration/auth-logout.int-spec.ts test/integration/auth-blocked-status.int-spec.ts test/integration/auth-coverage.int-spec.ts test/integration/employees-rbac-scope.int-spec.ts test/integration/employees-salary-sensitive.int-spec.ts --coverage --coverage.include='src/permission/data-scope.service.ts' --coverage.include='src/auth/auth.service.ts' --coverage.include='src/permission/permission.service.ts' --coverage.include='src/auth/auth-logs-viewer.controller.ts' --coverage.include='src/auth/auth-logs-viewer.service.ts' --coverage.include='src/auth/login-log.repository.ts' --coverage.include='src/auth/security-event.repository.ts' --coverage.reporter=text-summary --coverage.reporter=text --no-file-parallelism --coverage.clean=true",
    "test:cov:call": "vitest run src/chat/chat-call-signal-deny.spec.ts src/chat/chat-call-ice.service.spec.ts src/chat/chat-calls.invite-cooldown.spec.ts src/realtime/call-signalling.gateway.spec.ts src/realtime/call-signalling.filter.spec.ts test/integration/chat-s7-call-be1-lifecycle.int-spec.ts test/integration/chat-s7-call-rt1-signalling.int-spec.ts --coverage --coverage.include='src/chat/chat-call*.ts' --coverage.include='src/chat/chat-calls*.ts' --coverage.include='src/realtime/call-signalling*.ts' --coverage.reporter=text --no-file-parallelism --coverage.clean=true",
    "test:cov:asset": "vitest run src/assets test/integration/asset-be1-fsm.int-spec.ts test/integration/asset-be1-scope.int-spec.ts test/integration/asset-be1-inventory-counter.int-spec.ts test/integration/asset-be1-noti-idempotency.int-spec.ts test/integration/s11-asset-qa1-permission-matrix.int-spec.ts test/integration/s11-asset-qa1-idempotency-scope.int-spec.ts test/integration/s11-asset-qa1-error-residue.int-spec.ts --coverage --coverage.include='src/assets/**' --coverage.reporter=text --coverage.reporter=text-summary --coverage.clean=true",
    "test:cov:room": "vitest run src/rooms test/integration/room-be1-booking.int-spec.ts test/integration/room-be1-scope.int-spec.ts test/integration/room-be1-noti.int-spec.ts test/integration/s11-room-qa1-permission-matrix.int-spec.ts test/integration/s11-room-qa1-idempotency-scope.int-spec.ts test/integration/s11-room-qa1-error-residue.int-spec.ts --coverage --coverage.include='src/rooms/**' --coverage.reporter=text --coverage.reporter=text-summary --coverage.clean=true",
    "test:cov:recruit": "vitest run src/recruit test/integration/recruit-be1-scope.int-spec.ts test/integration/recruit-be1-fsm.int-spec.ts test/integration/recruit-be1-convert.int-spec.ts test/integration/recruit-be1-interview-offer.int-spec.ts test/integration/recruit-be1-idempotency-audit.int-spec.ts test/integration/recruit-be1-noti.int-spec.ts test/integration/s12-recruit-qa1-permission-matrix.int-spec.ts test/integration/s12-recruit-qa1-idempotency-scope.int-spec.ts test/integration/s12-recruit-qa1-error-residue.int-spec.ts --coverage --coverage.include='src/recruit/**' --coverage.reporter=text --coverage.reporter=text-summary --coverage.clean=true",
    "test:cov:payroll": "vitest run src/payroll test/integration/payroll-be1-errors.int-spec.ts test/integration/payroll-be1-inputs-audit.int-spec.ts test/integration/payroll-be1-scope.int-spec.ts test/integration/payroll-be2-lifecycle.int-spec.ts test/integration/payroll-be2-noti-audit.int-spec.ts test/integration/payroll-be2-permission.int-spec.ts test/integration/s13-payroll-qa1-scope-floor.int-spec.ts test/integration/s13-payroll-qa1-fsm-race.int-spec.ts test/integration/s13-payroll-qa1-idor-tenant.int-spec.ts test/integration/s13-payroll-qa1-arithmetic.int-spec.ts --coverage --coverage.include='src/payroll/**' --coverage.reporter=text --coverage.reporter=text-summary --no-file-parallelism --coverage.clean=true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check.ts",
    "gen:openapi": "nest build && node dist/scripts/gen-openapi.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@date-fns/tz": "^1.5.0",
    "@mediaos/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/websockets": "^11.1.26",
    "@node-rs/argon2": "^2.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nestjs-zod": "^4.3.0",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "^0.30.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.0"
  }
}
