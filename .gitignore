# deps
node_modules/
.pnpm-store/

# apps/lms — LMS (fmc-app) nhập tại chỗ, chạy độc lập bằng stack riêng (Next.js+SQLite).
# KHÔNG commit vào repo MediaOS (PUBLIC): chứa data/app.db (PII + password hash) + .env secret.
# Version hoá riêng nếu cần (repo private tách biệt).
/apps/lms/

# harness — artefact runtime (ledger có timestamp + báo cáo tự sinh), KHÔNG commit
harness/activity.jsonl
harness/report.md

# build
dist/
# S6-REL-1 (D3) — artifact deploy PROD: snapshot BẤT BIẾN của apps/api/dist + junction `current`.
# Là sản phẩm build, KHÔNG phải nguồn ⇒ không vào git (xem scripts/release-artifact.mjs).
apps/api/releases/
build/
.turbo/
*.tsbuildinfo

# OpenAPI artifact (S2-FND-CONTRACT-1) — sinh bằng `pnpm --filter @mediaos/api gen:openapi`, KHÔNG commit
openapi.json
apps/api/openapi.json

# env & secrets
.env
.env.*
!.env.example
!.env.dev-online.example
.secrets/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# test / coverage
coverage/
# QA evidence artifacts (RED-before-GREEN capture, CI logs) — luôn TRACK dù trùng pattern scratch/coverage.
# Negate-pattern HẸP: chỉ whitelist docs/QA/evidence/**, KHÔNG nới rộng ignore nào khác.
!docs/QA/evidence/
!docs/QA/evidence/**

# planning prompts (scratch — kept locally, not tracked)
docs/prompts/

# MCP local config — chứa đường dẫn binary tuyệt đối theo máy, KHÔNG portable, KHÔNG commit (repo public)
.mcp.json

# Runtime service logs (NSSM/PROD) — không bao giờ commit (từng chứa token)
logs/

# Dump backup DB (scripts/backup-db.sh) — chứa PII 45 nhân viên + hash mật khẩu + audit log.
# BẤT BIẾN #3: KHÔNG BAO GIỜ commit, kể cả bản đã mã hoá (repo PUBLIC). Thêm ở S6-GOLIVE-1 —
# trước đó thư mục này không bị ignore, chạy backup ở gốc repo là đẩy thẳng PII vào tầm với của `git add`.
backups/
*.dump
*.dump.age
*.dump.gpg

# Artefact phiên Playwright MCP (a11y snapshot `page-*.yml` + `console-*.log`) — ghi vào gốc repo
# mỗi lần agent mở trình duyệt. Là ẢNH CHỤP MÀN HÌNH LÚC ĐÓ, không phải nguồn; snapshot của trang
# ĐÃ đăng nhập có thể chứa dữ liệu thật (repo PUBLIC). Console log đã dính `*.log` ở trên, nhưng
# `*.yml` thì không ⇒ phải ignore cả thư mục.
.playwright-mcp/

# Ảnh rời rơi ở GỐC repo (screenshot QA tay: `reel-logged-out.jpeg`…). Neo `/` nên CHỈ gốc —
# ảnh trong `apps/**/public/`, `docs/**` vẫn track bình thường.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
